# URL public của web sau khi deploy (dùng để tạo link trong email)
APP_URL=https://your-site.netlify.app

# Secret dùng để ký JWT cho link mã hoá - tạo 1 chuỗi random dài, ví dụ bằng: openssl rand -hex 32
JWT_SECRET=

# Firebase Admin SDK (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Lưu ý: giữ nguyên các ký tự \n trong private key khi dán vào Netlify env vars
FIREBASE_PRIVATE_KEY=

# Gmail SMTP - dùng App Password (không dùng mật khẩu Gmail thường)
# Tạo tại: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
